// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Relation {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

model FamilyMember {
  id        String   @id @default(uuid())
  name      String
  relation  Relation
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("family_members")
}

enum ContactRole {
  PRIMARY
  BACKUP
}

enum VerificationStatus {
  PENDING
  VERIFIED
}

model TrustedContact {
  id                 String             @id @default(uuid())
  name               String
  relation           Relation
  role               ContactRole
  phone              String
  email              String?
  verificationStatus VerificationStatus @default(PENDING)
  detail             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("trusted_contacts")
}

enum AssetCategory {
  BANK
  INSURANCE
  PROPERTY
  INVESTMENT
  CRYPTO
  OTHER
}

model AssetReference {
  id           String         @id @default(uuid())
  name         String
  category     AssetCategory
  locationHint String?
  detail       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("asset_references")
}
