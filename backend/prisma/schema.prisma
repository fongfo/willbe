// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Relation {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

model FamilyMember {
  id        String   @id @default(uuid())
  name      String
  relation  Relation
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("family_members")
}

enum ContactRole {
  PRIMARY
  BACKUP
}

enum VerificationStatus {
  PENDING
  VERIFIED
}

model TrustedContact {
  id                 String             @id @default(uuid())
  name               String
  relation           Relation
  role               ContactRole
  phone              String
  email              String?
  verificationStatus VerificationStatus @default(PENDING)
  detail             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("trusted_contacts")
}

enum AssetCategory {
  BANK
  INSURANCE
  PROPERTY
  INVESTMENT
  CRYPTO
  OTHER
}

model AssetReference {
  id           String         @id @default(uuid())
  name         String
  category     AssetCategory
  locationHint String?
  detail       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("asset_references")
}

enum CheckInFrequency {
  EVERY_3_MONTHS
  EVERY_6_MONTHS
  EVERY_12_MONTHS
  CUSTOM_ANNUAL
}

enum CloudProvider {
  GOOGLE_DRIVE
  ONEDRIVE
  DROPBOX
  ICLOUD
}

// Single global record (no per-user scoping yet): the plan's review cadence and
// the set of cloud-storage providers the user has linked. Cloud "integration" here
// is a reference only — we store which providers are connected, never credentials
// or file contents — consistent with the asset-reference philosophy.
model ReviewSetting {
  id                 String           @id @default(uuid())
  checkInFrequency   CheckInFrequency @default(EVERY_6_MONTHS)
  connectedProviders CloudProvider[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("review_settings")
}
