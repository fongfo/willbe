// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Relation {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

model FamilyMember {
  id        String   @id @default(uuid())
  userId    String
  name      String
  relation  Relation
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId])
  @@map("family_members")
}

enum ContactRole {
  PRIMARY
  BACKUP
}

enum VerificationStatus {
  PENDING
  VERIFIED
}

model TrustedContact {
  id                 String             @id @default(uuid())
  userId             String
  contactUserId      String?
  name               String
  relation           Relation
  role               ContactRole
  phone              String
  email              String?
  verificationStatus VerificationStatus @default(PENDING)
  detail             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation("TrustedContactOwner", fields: [userId], references: [id], onDelete: Cascade)
  contactUser        User?              @relation("TrustedContactLogin", fields: [contactUserId], references: [id], onDelete: SetNull)

  @@unique([id, userId])
  @@index([contactUserId])
  @@index([userId])
  @@map("trusted_contacts")
}

enum AssetCategory {
  BANK
  INSURANCE
  PROPERTY
  INVESTMENT
  CRYPTO
  OTHER
}

model AssetReference {
  id           String         @id @default(uuid())
  userId       String
  name         String
  category     AssetCategory
  locationHint String?
  detail       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId])
  @@map("asset_references")
}

enum CheckInFrequency {
  EVERY_3_MONTHS
  EVERY_6_MONTHS
  EVERY_12_MONTHS
  CUSTOM_ANNUAL
}

enum CloudProvider {
  GOOGLE_DRIVE
  ONEDRIVE
  DROPBOX
  ICLOUD
}

model ReviewSetting {
  id                 String           @id @default(uuid())
  userId             String           @unique
  checkInFrequency   CheckInFrequency @default(EVERY_6_MONTHS)
  connectedProviders CloudProvider[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("review_settings")
}

model HandoverInstruction {
  id         String   @id @default(uuid())
  userId     String   @unique
  message    String?
  firstSteps String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("handover_instructions")
}

model User {
  id            String   @id @default(uuid())
  privyUserId   String   @unique
  email         String?
  name          String?
  walletAddress String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  familyMembers FamilyMember[]
  trustedContacts TrustedContact[] @relation("TrustedContactOwner")
  emergencyContactAssignments TrustedContact[] @relation("TrustedContactLogin")
  assetReferences AssetReference[]
  reviewSetting ReviewSetting?
  handoverInstruction HandoverInstruction?

  @@map("users")
}
