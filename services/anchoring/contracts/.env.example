# Polygon Amoy testnet deployment config for the Proof of Plan contract.
# Copy to `.env` and fill in. NEVER commit the real `.env`.

# JSON-RPC endpoint for Polygon Amoy (default public RPC works for low volume).
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of a funded Amoy deployer account (get test MATIC from a faucet).
# Required only for `npm run deploy:amoy`; never needed for compile/test.
DEPLOYER_PRIVATE_KEY=

# Optional — Polygonscan (Amoy) API key, only for `hardhat verify`.
POLYGONSCAN_API_KEY=
