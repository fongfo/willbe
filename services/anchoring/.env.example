PORT=4100
NODE_ENV=development

# Custodial wallet provider. The MVP uses an in-memory MOCK provider: deterministic
# addresses, no real keys, no chain calls, no funds. A real custodian (KMS/MPC) is
# configured here before any testnet use (Polygon Amoy), never committed.
WALLET_PROVIDER=MOCK

# Proof of Plan gateway. MOCK increments versions locally and returns deterministic
# transaction hashes; it never signs or broadcasts real transactions.
PROOF_GATEWAY=MOCK
PROOF_NETWORK=polygon-amoy
PROOF_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
